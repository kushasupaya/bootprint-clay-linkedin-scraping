# Copy to .env (git-ignored) and fill in. Needed only for sending outreach email.
# Gmail app password: Google Account > Security > 2-Step Verification > App passwords.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Used in the From line and the signature of the draft.
SENDER_NAME=Your Name
# Optional: where test-mode emails go (python3 testmode.py). Defaults to GMAIL_ADDRESS.
TEST_EMAIL=
