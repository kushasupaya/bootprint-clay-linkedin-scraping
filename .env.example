# Copy to .env (git-ignored) and fill in. Needed only for sending outreach email.
# Gmail app password: Google Account > Security > 2-Step Verification > App passwords.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Used in the From line and the signature of the draft.
SENDER_NAME=Your Name
# Optional: where test-mode emails go (python3 testmode.py). Defaults to GMAIL_ADDRESS.
TEST_EMAIL=

# Slack daily digest (python3 digest.py). Create a Slack app in your own workspace with the
# chat:write bot scope, install it, and paste the Bot User OAuth Token (starts with xoxb-).
# To approve outreach emails with a green-check reaction (approvals.py), also add the reactions:read scope.
# SLACK_USER_ID is your member ID: profile > three dots > Copy member ID.
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_USER_ID=U0123456789
